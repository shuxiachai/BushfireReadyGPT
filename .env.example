LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=bushfire-ready-qwen

# Required only when the configured model endpoint is not localhost, 127.0.0.0/8 or ::1.
# Users must also acknowledge the external-model disclosure in each browser session.
BUSHFIRE_ALLOW_EXTERNAL_MODEL=false

# Provider safety limits. Applies to local and external OpenAI-compatible endpoints.
BUSHFIRE_MODEL_TIMEOUT_SECONDS=120
BUSHFIRE_MODEL_MAX_TOKENS=4096
BUSHFIRE_MODEL_MAX_RETRIES=1
BUSHFIRE_MODEL_TEMPERATURE=0.2
BUSHFIRE_MODEL_SEED=42

# In-process legacy chat history is bounded even when the app stays open for a long demo.
BUSHFIRE_THREAD_TTL_SECONDS=3600
BUSHFIRE_THREAD_MAX_COUNT=128
BUSHFIRE_THREAD_MAX_MESSAGES=64

# Optional local RAG. Embeddings are deliberately restricted to a loopback Ollama endpoint.
BUSHFIRE_RAG_ENABLED=true
BUSHFIRE_RAG_EMBED_BASE_URL=http://127.0.0.1:11434
BUSHFIRE_RAG_EMBED_MODEL=embeddinggemma
BUSHFIRE_RAG_TOP_K=8
BUSHFIRE_RAG_SCORE_THRESHOLD=0.35
# Hybrid retrieval: dense candidates are fused with BM25 by reciprocal-rank fusion.
BUSHFIRE_RAG_CANDIDATE_MULTIPLIER=4
BUSHFIRE_RAG_DENSE_WEIGHT=0.65
BUSHFIRE_RAG_RRF_K=60
BUSHFIRE_RAG_MAX_CHUNKS_PER_SOURCE=3
# Retrieval abstains unless query terms have enough passage support. Dense-only
# matches require both stronger similarity and a minimum shared-term signal.
BUSHFIRE_RAG_LEXICAL_COVERAGE_THRESHOLD=0.61
BUSHFIRE_RAG_SEMANTIC_SCORE_THRESHOLD=0.45
BUSHFIRE_RAG_SEMANTIC_COVERAGE_THRESHOLD=0.20

# Optional single-user plaintext persistence; it can contain full reports and sign-off identity.
# Leave unset for isolated in-memory browser sessions and never share one file across users.
# BUSHFIRE_SESSION_STATE_PATH=chat_history/session_state.json

# Audit events are privacy-minimised by default and retained separately from the session.
# BUSHFIRE_AUDIT_DIR=chat_history/audit
# Do not enable unless the operator has an approved retention and access-control policy.
# BUSHFIRE_AUDIT_INCLUDE_SENSITIVE_CONTENT=false
