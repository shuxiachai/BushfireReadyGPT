# Container / Railway controlled-demo configuration.
# Copy this template to .env.cloud for local Docker; never put real credentials here.
# Fill secrets in Railway Variables or the ignored local .env.cloud file.
BUSHFIRE_DEPLOYMENT_MODE=cloud
BUSHFIRE_RUNTIME_DIR=/data

# Railway mounts volumes as root. The entrypoint changes only /data ownership,
# then drops supplementary groups and switches to the bushfire UID/GID 10001.
# This Railway setting does not override Docker's local --user option.
RAILWAY_RUN_UID=0

LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Required shared demonstration password: 16-1024 characters, >=8 distinct characters.
# Alternatively set BUSHFIRE_ACCESS_PASSWORD_HASH and leave the plaintext value unset.
BUSHFIRE_ACCESS_PASSWORD=
# BUSHFIRE_ACCESS_PASSWORD_HASH=

# Optional separate administrator login. Do not reuse the demonstration password.
# Leave both unset to keep administrator-only diagnostics inaccessible to visitors.
# BUSHFIRE_ADMIN_PASSWORD=
# BUSHFIRE_ADMIN_PASSWORD_HASH=

# Operator permission does not replace each browser session's privacy acknowledgement.
BUSHFIRE_ALLOW_EXTERNAL_MODEL=true
BUSHFIRE_MODEL_TIMEOUT_SECONDS=120
BUSHFIRE_MODEL_MAX_TOKENS=2300
BUSHFIRE_MODEL_MAX_RETRIES=0
BUSHFIRE_MODEL_MAX_CONCURRENT=1
# Shared allowance for actual model request attempts, including repair attempts.
# Resets at 00:00 UTC. This is not a token allowance or a currency spending cap.
BUSHFIRE_MODEL_DAILY_CALL_LIMIT=100

# CPU model assets are prepared during the Docker build; a verified private
# corpus is indexed once on /data at first startup. No source websites are fetched.
BUSHFIRE_RAG_ENABLED=true
BUSHFIRE_RAG_EMBED_PROVIDER=fastembed
BUSHFIRE_RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
BUSHFIRE_RAG_EMBED_CACHE_DIR=/opt/bushfire/models
BUSHFIRE_RAG_EMBED_LOCAL_FILES_ONLY=true
BUSHFIRE_RAG_EMBED_THREADS=2
BUSHFIRE_RAG_CORPUS_BUNDLE=/opt/bushfire/corpus
# Required: manifest_sha256 printed by scripts/prepare_private_corpus.py.
BUSHFIRE_RAG_CORPUS_SHA256=
BUSHFIRE_RAG_TOP_K=8
BUSHFIRE_RAG_SEMANTIC_SCORE_THRESHOLD=0.70

BUSHFIRE_TRACE_ENABLED=true
BUSHFIRE_AUDIT_INCLUDE_SENSITIVE_CONTENT=false
BUSHFIRE_PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Leave PORT unset on Railway so the platform supplies it. Docker defaults to 8501.
# Do not set BUSHFIRE_SESSION_STATE_PATH or BUSHFIRE_INTERACTION_LOG_PATH in cloud mode.
# Do not override BUSHFIRE_RAG_DIR / RAW_DIR / INDEX_DIR: startup selects a verified
# /data/private-rag/<corpus_manifest_sha256>/ directory and preserves old generations.
# To omit the optional national map, use the Docker build argument
# BUSHFIRE_INCLUDE_NATIONAL_MAP=false; changing it only at runtime has no effect.
